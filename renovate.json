{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["after 4am and before 5am"]
  },
  "labels": ["renovate"],
  "argocd": {
    "enabled": true,
    "managerFilePatterns": [
      "/^kubernetes\\/apps\\/addons\\/argocd-apps\\/application\\.ya?ml$/",
      "/^kubernetes\\/apps\\/addons\\/argocd-apps\\/templates\\/.+\\.ya?ml$/"
    ]
  },
  "helmv3": {
    "enabled": true,
    "managerFilePatterns": [
      "/^kubernetes\\/bootstrap\\/helmfile\\.ya?ml$/"
    ]
  },
  "helmfile": {
    "enabled": true
  },
  "helm-values": {
    "enabled": true,
    "managerFilePatterns": [
      "/^kubernetes\\/apps\\/.+\\/values\\.ya?ml$/",
      "/^kubernetes\\/apps\\/.+\\/values\\.sops\\.ya?ml$/"
    ]
  },
  "terraform": {
    "enabled": true,
    "managerFilePatterns": ["/^terraform\\/.+\\.tf$/"]
  },
  "github-actions": {
    "enabled": true
  },
  "dockerfile": {
    "enabled": true
  },
  "docker-compose": {
    "enabled": true
  },
  "ansible-galaxy": {
    "enabled": true
  },
  "pep621": {
    "enabled": true
  },
  "pyenv": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Ignore git URL picked up natively by ansible manager — handled by custom manager",
      "matchPackageNames": ["https://github.com/k3s-io/k3s-ansible.git"],
      "enabled": false
    },
    {
      "description": "Do not update image tags pinned to latest",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^latest$/",
      "enabled": false
    },
    {
      "description": "Use regex versioning for afonsoc12/airflow build tags (3.x.y-bN)",
      "matchPackageNames": ["ghcr.io/afonsoc12/airflow"],
      "versioning": "regex:^\\d+\\.\\d+\\.\\d+-b(?<patch>\\d+)$"
    },
    {
      "description": "Use regex versioning for fireflyiii/core tags (version-X.Y.Z)",
      "matchPackageNames": ["docker.io/fireflyiii/core"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Track hotio image by digest",
      "matchPackageNames": ["ghcr.io/hotio/cloudflareddns"],
      "pinDigests": true
    },
    {
      "description": "Track Unraid docker-compose images with no published version tags by digest",
      "matchPackageNames": ["ghcr.io/afonsoc12/kopia-temp"],
      "pinDigests": true
    },
    {
      "description": "Pin Helm chart versions in ArgoCD (remove range constraints)",
      "matchManagers": ["argocd"],
      "matchDepTypes": ["helm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Avoid updating encrypted blobs in SOPS files",
      "matchFileNames": ["**/*.sops.yaml"],
      "matchCurrentValue": "/^ENC\\[/",
      "enabled": false
    },
    {
      "description": "Keep HELM3_VERSION pinned to the 3.x line — it's a Helm v3 binary used specifically to work around helm-secrets not yet supporting Helm v4's plugin format; bumping to v4.x would defeat the pin",
      "matchDepNames": ["helm/helm"],
      "matchFileNames": ["kubernetes/apps/addons/argocd/values.sops.yaml"],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "Group ArgoCD app-of-apps minor/patch updates",
      "matchManagers": ["argocd"],
      "matchFileNames": ["kubernetes/apps/addons/argocd-apps/**"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "argocd app definitions"
    },
    {
      "description": "Group Helm chart dependency minor/patch updates",
      "matchManagers": ["helmv3"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "helm chart dependencies"
    },
    {
      "description": "Group Helm values image minor/patch updates",
      "matchManagers": ["helm-values"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "helm values images"
    },
    {
      "description": "Group Terraform provider minor/patch updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "terraform providers"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group Docker Compose image minor/patch updates",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "docker compose images"
    },
    {
      "description": "Group Python dependency minor/patch updates",
      "matchManagers": ["pep621", "pyenv", "dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "python"
    },
    {
      "description": "Group Ansible collection minor/patch updates",
      "matchManagers": ["ansible-galaxy"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "ansible"
    },
    {
      "description": "linuxserver.io images carry stale orphaned tags from ~2021 (dev/nightly builds, or unrelated numeric fragments like an embedded Ubuntu base version) that outrank the real current version under naive numeric sort. bazarr/tautulli junk is huge random numbers or a year-stamp, nowhere near a plausible real version, so a generous <1000.0.0 bound leaves headroom for real future majors with no meaningful cap.",
      "matchPackageNames": ["ghcr.io/linuxserver/bazarr", "ghcr.io/linuxserver/tautulli"],
      "allowedVersions": "<1000.0.0"
    },
    {
      "description": "calibre-web's junk isn't 1-2 stray tags like lidarr/qbittorrent — it's a whole dead family of 14 tags (5.29.0 through 5.33.2, plus v5.4.2-ls1 through v5.7.2-ls1), all created 2021-12-04, and Renovate has already been observed silently retargeting this package's PR between different tags in that family (5.33.2, then 5.33.1) as it rechecks. Exact-tag exclusion can't keep up with that — back to a numeric bound. Current is 0.x, so if calibre-web ever ships a real v5+, this needs a human to revisit (no numeric bound can tell a real v5 apart from this dead family).",
      "matchPackageNames": ["ghcr.io/linuxserver/calibre-web"],
      "allowedVersions": "<5.0.0"
    },
    {
      "description": "lidarr/qbittorrent junk tags (8.1.2135, 20.04.1, 14.3.9) sit too close to a plausible real future major for a range bound — that would cap legitimate future majors instead of just the known junk. Confirmed only these exact one-off tags exist in their respective bad majors (unlike calibre-web), so exact-tag exclusion is safe here.",
      "matchPackageNames": ["ghcr.io/linuxserver/lidarr"],
      "allowedVersions": "!/^8\\.1\\.2135$/"
    },
    {
      "matchPackageNames": ["ghcr.io/linuxserver/qbittorrent"],
      "allowedVersions": "!/^(20\\.04\\.1|14\\.3\\.9)$/"
    },
    {
      "description": "sonarr's stale tag (5.14, created 2021-03-09, no version label) has no dedicated numeric bound above it since Sonarr has genuinely shipped a real v5 — require the real three-segment X.Y.Z shape instead, which the stale tag doesn't match",
      "matchPackageNames": ["ghcr.io/linuxserver/sonarr"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update helm-secrets version in ArgoCD init container",
      "managerFilePatterns": ["/^kubernetes\\/apps\\/addons\\/argocd\\/values\\.sops\\.ya?ml$/"],
      "matchStrings": ["- name: HELM_SECRETS_VERSION\\s+value: (?<currentValue>[^\\n]+)"],
      "depNameTemplate": "jkroepke/helm-secrets",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update helm3 version in ArgoCD init container (helm-secrets delegate)",
      "managerFilePatterns": ["/^kubernetes\\/apps\\/addons\\/argocd\\/values\\.sops\\.ya?ml$/"],
      "matchStrings": ["- name: HELM3_VERSION\\s+value: (?<currentValue>[^\\n]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update sops version in ArgoCD init container",
      "managerFilePatterns": ["/^kubernetes\\/apps\\/addons\\/argocd\\/values\\.sops\\.ya?ml$/"],
      "matchStrings": ["- name: SOPS_VERSION\\s+value: (?<currentValue>[^\\n]+)"],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update vals version in ArgoCD init container",
      "managerFilePatterns": ["/^kubernetes\\/apps\\/addons\\/argocd\\/values\\.sops\\.ya?ml$/"],
      "matchStrings": ["- name: VALS_VERSION\\s+value: (?<currentValue>[^\\n]+)"],
      "depNameTemplate": "helmfile/vals",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update kubectl version in ArgoCD init container",
      "managerFilePatterns": ["/^kubernetes\\/apps\\/addons\\/argocd\\/values\\.sops\\.ya?ml$/"],
      "matchStrings": ["- name: KUBECTL_VERSION\\s+value: (?<currentValue>[^\\n]+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Track hotio image digest in sops values",
      "managerFilePatterns": [
        "/^kubernetes\\/apps\\/ingress\\/cloudflare-ddns-.+\\/values\\.sops\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository: (?<depName>ghcr\\.io/hotio/[^\\n]+)\\s+digest: (?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest"
    },
    {
      "customType": "regex",
      "description": "Update k3s version in Ansible group vars",
      "managerFilePatterns": [
        "/^ansible\\/inventory\\/group_vars\\/k3s_cluster\\.sops\\.ya?ml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s+(?<currentValue>[^\\n]+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update k3s-ansible git collection in Ansible requirements",
      "managerFilePatterns": ["/^ansible\\/requirements\\.ya?ml$/"],
      "matchStrings": [
        "name: https://github\\.com/k3s-io/k3s-ansible\\.git\\s+type: git\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "k3s-io/k3s-ansible",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update Tailscale version in Ansible group vars",
      "managerFilePatterns": [
        "/^ansible\\/inventory\\/group_vars\\/all\\.sops\\.ya?ml$/"
      ],
      "matchStrings": [
        "tailscale_version:\\s+(?<currentValue>[^\\n]+)"
      ],
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
