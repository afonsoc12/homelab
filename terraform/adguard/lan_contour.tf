# Explicit records leave public tunnel routes and unmigrated local apps unchanged.
resource "adguard_rewrite" "lan_contour" {
  for_each = toset([
    "adguard",
    "airflow",
    "alertmanager",
    "argocd",
    "bambu",
    "bazarr",
    "booklore",
    "changedetection",
    "cookistash",
    "decide",
    "electricity",
    "grocy",
    "hyperion",
    "kopia",
    "krusader",
    "ldap",
    "lidarr",
    "longhorn",
    "mariana-afonso",
    "mealie",
    "n8n",
    "navidrome",
    "node-red",
    "ntfy",
    "paperless",
    "pdf",
    "prometheus",
    "prowlarr",
    "qbit",
    "radarr",
    "radarr-4k",
    "scrutiny",
    "sign",
    "sonarr",
    "tautulli",
    "tdarr",
    "tracktor",
    "unifi",
    "wealth",
    "wg",
    "wled-kitchen",
  ])

  domain = "${each.value}.local.${local.domain}"
  answer = data.sops_file.contour.data["envoy.service.loadBalancerIP"]
}
